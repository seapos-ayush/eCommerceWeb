@{
    ViewData["Title"] = "Add Address";
}

@model AddressRequest

<div class="container">
    <form novalidate class="theme-form ng-untouched ng-pristine ng-invalid" asp-action="AddAddress" asp-controller="Order" method="post">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="row mb-5">
                    <div class="col-12">
                      @*   <a class="text-success-emphasis fs-6" href="javascript:history.back()">
                            <i aria-hidden="true" class="fa fa-angle-left me-3"></i> Back To My Address
                        </a> *@
                        <a class="text-success-emphasis fs-6" href="@Url.Action("MyAddress","Account")" >
                            <i aria-hidden="true" class="fa fa-angle-left me-3"></i> Back To My Address
                        </a>
                    </div>
                </div>
                <h3 class="mt-1 mb-2 text-black fw-bold"> Add new address <!----><!----></h3>
                <div class="row check-out">
                    <input type="hidden" asp-for="Id" value="@Model.Id" >
                    <input type="hidden" asp-for="CustomerId" value="@Model.CustomerId">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl">

                    <div class="form-group col-md-6 col-sm-6 col-xs-12">
                        <label asp-for="FirstName" class="form-label">First Name<span class="text-danger"> *</span></label>
                        <input asp-for="FirstName" type="text" class="form-control">
                    </div>
                    <div class="form-group col-md-6 col-sm-6 col-xs-12">
                        <label asp-for="LastName" class="form-label">Last Name</label>
                        <input asp-for="LastName"  type="text" class="form-control">
                    </div>
                    <div class="form-group col-md-6 col-sm-6 col-xs-12">
                        <label asp-for="Phone" class="form-label">Phone<span class="text-danger"> *</span></label>
                        <input asp-for="Phone" type="text" class="form-control"><!---->
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-12 col-sm-12 col-xs-12">
                        <label asp-for="CountryId" class="form-label">Country<span class="text-danger"> *</span></label>
                        <select asp-for="CountryId"    class="form-select">
                            <option value="" selected="">Select Country</option>
                            <option value="1">India</option>
                            <option value="2">USA</option>
                        </select><!---->
                        <span asp-validation-for="CountryId" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-12 col-sm-12 col-xs-12">
                        <label asp-for="Address" class="form-label">Address<span class="text-danger"> *</span></label>
                        <input asp-for="Address" type="text" class="form-control"><!---->
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-12 col-sm-12 col-xs-12">
                        <label asp-for="City" class="form-label">Town/City<span class="text-danger"> *</span></label>
                        <input asp-for="City"  type="text"  class="form-control"><!---->
                    </div>
                    <div class="form-group col-md-12 col-sm-6 col-xs-12">
                        <label asp-for="State" class="form-label">State<span class="text-danger"> *</span></label>
                        <input type="text" asp-for="State"   class="form-control"><!---->
                    </div>
                    <div class="form-group col-md-12 col-sm-6 col-xs-12">
                        <label asp-for="PostalCode" class="form-label">Postal Code<span class="text-danger"> *</span></label>
                        <input asp-for="PostalCode"  type="text" class="form-control"><!---->
                    </div>
                    <div class="form-check mt-3 ms-3">
                        <input type="checkbox" asp-for="SetIsDefault" class="form-check-input">
                        <label asp-for="SetIsDefault" class="form-check-label"> Make this my default address </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-center">
            <div>
                <button type="submit" class="btn px-4 py-1 fw-light bg-warning text-dark rounded mb-4">
                    @(Model.Id == 0 ? "Add Address" : "Update Address")
                </button>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
