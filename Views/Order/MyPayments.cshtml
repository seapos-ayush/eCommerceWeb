@using eCommerceWeb.Models.Response
@model List<GetAll_CustomerOrderDetails_Response>
@{
    ViewData["Title"] = "MyPayments";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var imagePath = "https://www.sahosoftweb.com/Images/Ecomm/";
    var groupedOrders = Model
          .Where(x => x.OrderStatusId != 4)
          .GroupBy(x => x.OrderId)
          .Select(g => new { OrderId = g.Key, Data = g.ToList() })
          .ToList();
}



@if (groupedOrders != null && groupedOrders.Any())
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-12">
                <div class="row mb-5">
                    <div class="col-12">
                        <a class="text-success-emphasis fs-6" href="javascript:history.back()">
                            <i aria-hidden="true" class="fa fa-angle-left me-3"></i> Back To My Account
                        </a>
                    </div>
                </div>
                <div class="row mb-5">
                    <div class="col-12">
                        <h3>My Payment</h3>
                        <div class="border-2 border-bottom border-warning" style="width: 90px;"></div>
                    </div>
                </div>
                @foreach (var prod in groupedOrders)
                {
                    <div class="row ">
                        <div class="col-12">
                            <div class="card mb-3 border-0" style="box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;">
                                <div>
                                    <section class="pt-1" style="background-color: #eee;">
                                        <div class="container">
                                            <div class="row justify-content-center">
                                                @for (int i = 0; i < prod.Data.Count; i++)
                                                {
                                                    @if (i < 3)
                                                    {
                                                        <div class="col-md-1 col-2">
                                                            <div class="card">
                                                                <img alt="Laptop" class="card-img-top"
                                                                     style="height: 80px; object-fit: cover;"
                                                                     src="@($"{imagePath}{Model[i].PicturePath}")" alt="@Model[i].ProductName">
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (i >= 3)
                                                    {
                                                        <div class="col-md-1 col-2 p-0">
                                                            <span>
                                                                <small>
                                                                    <i class="fa fa-circle text-secondary me-1" aria-hidden="true"></i>
                                                                    <i class="fa fa-circle text-secondary me-1" aria-hidden="true"></i>
                                                                    <i class="fa fa-circle text-secondary me-1"
                                                                       aria-hidden="true"></i>
                                                                </small>
                                                            </span>
                                                        </div>
                                                    }
                                                }
                                                <!----><!----><!---->
                                            </div>
                                        </div>
                                    </section>
                                </div>
                                <div class="card-body row justify-content-center">
                                    <div class="d-flex justify-content-evenly">
                                        <div>
                                            <h5 class="card-title">OrderId#<strong>@prod.OrderId</strong></h5>
                                            <p class="card-text">Order Date : <strong>@prod.Data[0]?.OrderDate</strong></p>
                                        </div>
                                        <a class="btn btn-solid" href="@Url.Action("Invoice", "Order", new { OrderId = prod.OrderId })">Get Invoice</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                      
                    </div>

                }
               
            </div>
        </div>
    </div>
} else
{
    <div class="row ng-star-inserted" style="min-height: 500px;">
        <div class="col-sm-12 empty-cart-cls text-center align-self-center">
            <img src="~/assets/images/empty-compare.png" class="img-fluid mb-4" />

            <h3>
                <strong>Payment is Empty</strong>
            </h3>

            <h4>
                Explore more shortlist some items.
            </h4>
        </div>
    </div>
}