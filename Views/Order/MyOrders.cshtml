@using eCommerceWeb.Models.Response

@{
    ViewData["Title"] = "MyOrders";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var imagePath = "https://www.sahosoftweb.com/Images/Ecomm/";
}
@model List<GetAll_CustomerOrderDetails_Response>

<style>
    .card-box {
        box-shadow: rgba(17, 17, 26, 0.1) 0px 1px 0px;
    }

   .card-box:hover {
            box-shadow: rgba(0, 0, 0, 0.24) 0px 3px 8px;
   }
</style>

@if (Model != null && Model.Any())
{
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-12">
                <div class="row mb-5">
                    <div class="col-12">
                        <a class="text-success-emphasis fs-6" href="javascript:history.back()">
                            <i aria-hidden="true" class="fa fa-angle-left me-3"></i> Back To My Account
                        </a>
                    </div>
                </div>
                <div class="row mb-5">
                    <div class="col-12">
                        <h3>My Orders</h3>
                        <div class="border-2 border-bottom border-warning" style="width: 90px;"></div>
                    </div>
                </div>
                <!---->
                <div class="row ">
                    <div class="col-12">
                        @foreach(var prod in Model)
                        {
                        <div class="mb-5 ">
                            <p class="mb-2">
                                    <small class="text-secondary">ORDER#<strong>@prod.OrderId</strong></small>
                            </p>
                            <div class="card rounded-1 border-0">
                                    @* <a  href="@Url.Action("orders/details", "home", new { billId = prod.BillId })"> *@
                                        <div class="row g-0 p-2 card-box">
                                            <div class="col-lg-3 col-12 text-center">
                                                <img  class="img-fluid"
                                                     style="max-width: 200px; height: 200px; object-fit: cover;"
                                                     src="@($"{imagePath}{prod.PicturePath}")" alt="@prod.ProductName">
                                            </div>
                                            <div class="col-lg-6 col-12 align-self-end">
                                                <div class="card-body pb-1">
                                                    <h5 class="card-title">@prod.ProductName</h5>
                                                    <p class="card-text">@prod.ShortDetails</p>
                                                    <p class="card-text">
                                                        <small class="text-muted">
                                                            <i aria-hidden="true"
                                                               class="text-warning fa fa-calendar-o me-1"></i>@prod.OrderDate
                                                        </small>
                                                    </p>
                                                    @if (@prod.OrderStatusId == 4)
                                                    {
                                                        <a class="text-danger p-2 text-uppercase"
                                                           style="background-color: #edc9c8; font-size: 0.8rem;">@prod.OrderStatus</a>
                                                    }
                                                    else
                                                    if (@prod.OrderStatusId == 3)
                                                    {
                                                        <a class="text-dark p-2 text-uppercase"
                                                           style="background-color: #ecedc8; font-size: 0.8rem;">@prod.OrderStatus</a>
                                                    }
                                                    else
                                                     if (@prod.OrderStatusId == 2)
                                                    {
                                                        <a class="text-success p-2 text-uppercase"
                                                           style="background-color: #ceedc8; font-size: 0.8rem;">@prod.OrderStatus</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="text-success p-2 text-uppercase"
                                                           style="background-color: #ceedc8; font-size: 0.8rem;">@prod.OrderStatus</a>
                                                    }


                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-12 align-self-end text-end">
                                            <form method="post" asp-controller="Order" asp-action="OrderDetails" style="display:inline;">
                                                <input type="hidden" name="billId" value="@prod.BillId" />
                                                <button type="submit" class="btn btn-solid border-0">Order Info</button>
                                            </form>
                                            </div>
                                        </div>

                                    @* </a> *@
                               
                            
                            </div>
                        </div>
                        <!---->
                        }
                    </div>
                </div>
                <!---->
            </div>
        </div>
    </div>

}
else
{
    <div class="row mb-5">

        <div class="col-md-12 empty-cart-cls text-center p-5">
            <img src="~/assets/images/empty-wishlist.png" alt="Empty cart" title="Emprt cart">
            <h3 class="mt-4"><b>Orders is Empty</b></h3>
            <h4>Explore more shortlist some items.</h4>
        </div>

    </div>
}


