@using eCommerceWeb.Models.Response

@{
    ViewData["Title"] = "PaymentSuccess";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model OrderDetailsViewModel


@if(Model != null)
{
    <section class="section-b-space light-layout ng-star-inserted">
        <div class="container">

            <div class="row mb-5">
                <div class="col-md-12">
                    <div class="success-text">
                        <i aria-hidden="true" class="fa fa-check-circle"></i>
                        <h2>thank you</h2>
                        <p>Payment has been received. Order Placed Successfully</p>
                        <p>Transaction ID : @Model.OrderId</p>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center">
                <div>
                    <a href="@Url.Action("MyOrders","Order")" class="btn btn-solid border-0" tabindex="0">
                        Track your orders
                    </a>
                </div>
            </div>

        </div>
    </section>
}


