@{
    ViewData["Title"] = "cartlist";
    var ImageBasePath = "https://sahosoftweb.com/Images/Ecomm/";
}
@model List<ProductSessionModel>
<div class="breadcrumb-section d-lg-block d-none">
    <div class="container">
        <div class="row">
            <div class="col-sm-6">
                <div class="page-title">
                    <h2>wishlist</h2>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb" class="theme-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")">Home</a>
                        </li>
                        <li class="breadcrumb-item active">cartlist</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
@if (Model != null && Model.Any())
{
    <section class="h-100 gradient-custom p-0">
        <div class="container">
            <div class="row d-flex justify-content-center my-4">
                <div class="col-md-8">
                    <div class="card mb-4">
                        <div class="card-body">
                            @foreach (var product in Model)
                            {
                                <div class="row ng-star-inserted cart-item2"
                                     data-id="@product.Id" data-price="@product.Price" data-sale="@product.SalePrice" data-qty="@product.Quantity">
                                    <div class="col-lg-3 col-md-12 mb-4 mb-lg-0">
                                        <a data-mdb-ripple-color="light"
                                           class="bg-image hover-overlay hover-zoom ripple rounded"
                                           href="@Url.Action("ProductDetails", "Product", new { category = product.Category, id = product.Id })">
                                            <img alt="image" class="w-75 rounded-1"
                                                 src="@($"{@ImageBasePath}{@product.Pictures ?? "default.jpg"}")" alt="@product.Name" >
                                            <a href="#!">
                                                <div class="mask" style="background-color: rgba(251, 251, 251, 0.2);">
                                                </div>
                                            </a>
                                        </a>
                                    </div>
                                    <div class="col-lg-5 col-md-6 mb-4 mb-lg-0">
                                        <a href="product-details.html">
                                            <strong>
                                                @product.Name
                                            </strong>
                                        </a>
                                        <p>Color: @product.Colors</p>
                                        <p>Size: @product.Size</p>
                                       @*  <button type="button" data-mdb-toggle="tooltip" title="Remove item"
                                                class="btn btn-primary btn-sm me-1 mb-2 rounded-1 px-3">
                                            <i class="fa fa-trash" aria-hidden="true"></i>
                                        </button> *@
                                        <a class="btn btn-primary btn-sm me-1 mb-2 rounded-1 px-3" href="@Url.Action("RemoveFromCart", "Cart", new { productId = product.Id })">Remove</a>

                                    </div>
                                    <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                                        <div class="qty-box">
                                            <div class="input-group">
                                                <span class="input-group-prepend">
                                                    <button type="button" class="form-control btn quantity-left-minus qty-btn" data-id="@product.Id" data-action="decrease">
                                                        <i class="fa fa-minus" aria-hidden="true"></i>
                                                    </button>
                                                </span>
                                                <input type="text" name="quantity"  value="@product.Quantity" data-id="@product.Id" disabled
                                                       class="form-control input-number qty-input2">
                                                <span class="input-group-prepend">
                                                    <button type="button" class="form-control btn quantity-right-plus qty-btn" data-id="@product.Id" data-action="increase">
                                                        <i class="fa fa-plus" aria-hidden="true"></i>
                                                    </button>
                                                </span>
                                            </div>
                                        </div>
                                        <h4 class="pt-3 text-center fs-5">
                                            ₹@product.SalePrice <span><del>₹@product.Price</del></span>
                                        </h4>
                                        <p class="text-success pt-2 fw-bold text-center">You saved ₹@(product.Price-product.SalePrice) each!</p>
                                    </div>
                                </div>
                                <hr class="my-4 ng-star-inserted">
                            }
                        </div>
                    </div>

                    <div class="card mb-4 mb-lg-0">
                        <div class="card-body">
                            <p><strong>We accept</strong></p>
                            <img width="45px"
                            src="https://mdbcdn.b-cdn.net/wp-content/plugins/woocommerce-gateway-stripe/assets/images/visa.svg"
                            alt="Visa" class="me-2">
                            <img width="45px"
                            src="https://mdbcdn.b-cdn.net/wp-content/plugins/woocommerce-gateway-stripe/assets/images/amex.svg"
                            alt="American Express" class="me-2">
                            <img width="45px"
                            src="https://mdbcdn.b-cdn.net/wp-content/plugins/woocommerce-gateway-stripe/assets/images/mastercard.svg"
                            alt="Mastercard" class="me-2">
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card mb-4">
                        <div class="card-header py-3">
                            <h5 class="mb-0 fs-5">PRICE SUMMARY</h5>
                        </div>
                        <div class="card-body">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                                    Total MRP (Incl. of taxes)
                                    <span id="totalMRP">₹0.00 </span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 pb-0">
                                    Delivery Fee
                                    <span class="text-success">Free</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    Discount
                                    <span id="discount"> - ₹0.00</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 mb-3">
                                    <div><strong>Subtotal</strong></div>
                                    <span><strong id="subtotal">₹0.00</strong></span>
                                </li>
                            </ul>
                            <div class="d-flex justify-content-between cart-buttons ng-star-inserted">
                                <a  class="btn btn-solid" href="@Url.Action("Index","Home")">
                                    continue
                                    shopping
                                </a>
                                <a href="@Url.Action("Checkout", "Order")" class="btn btn-solid">check out</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
}
else
{
    <div class="text-center my-5">
        <h3>Your cart is empty.</h3>
                <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Shop Now</a>
            </div>
}

<script>
          function updatePriceSummary() {
        let totalMRP = 0;
        let subtotal = 0;

        document.querySelectorAll('.cart-item2').forEach(item => {
            const price = parseFloat(item.dataset.price) || 0;
            const sale = parseFloat(item.dataset.sale) || 0;

            const input = item.querySelector('.qty-input2');
            const quantity = parseInt(input.value) || 1;

            totalMRP += price * quantity;
            subtotal += sale * quantity;
        });

        const discount = totalMRP - subtotal;

        document.getElementById('totalMRP').innerText = `₹${totalMRP.toFixed(2)}`;
        document.getElementById('discount').innerText = `- ₹${discount.toFixed(2)}`;
        document.getElementById('subtotal').innerText = `₹${subtotal.toFixed(2)}`;
    }
    document.addEventListener('DOMContentLoaded', function () {
        updatePriceSummary();

        document.querySelectorAll('.qty-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = document.querySelector(`.qty-input2[data-id="${btn.dataset.id}"]`);
                let value = parseInt(input.value) || 1;

                if (btn.dataset.action === "increase") value++;
                if (btn.dataset.action === "decrease" && value > 1) value--;

                input.value = value;
                updatePriceSummary();

                // Optional: send Ajax to update server-side cart
            });
        });

        document.querySelectorAll('.qty-input2').forEach(input => {
            input.addEventListener('change', function () {
                let val = parseInt(input.value);
                if (isNaN(val) || val < 1) input.value = 1;

                updatePriceSummary();

                // Optional: send Ajax to update server-side cart
            });
        });
    });
</script>
