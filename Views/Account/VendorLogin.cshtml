@{
    ViewData["Title"] = "Vendor Login";
}
@model LoginRequest
<section class="py-lg-5 py-0">
    <div class="container-fluid h-custom">
        <div class="row d-flex justify-content-center align-items-center">

            <!-- Welcome Section -->
            <div class="col-md-9 col-lg-6 col-xl-5 d-lg-block d-none">
                <div>
                    <p class="py-3 fs-3 fw-bold text-dark">
                        Welcome to the world of Shahosoft Mall
                    </p>
                </div>
                <img src="@Url.Content("~/assets/images/login_bg.png")" alt="Sample image" class="img-fluid" />
            </div>

            <!-- Vendor Login Form -->
            <div class="col-md-8 col-lg-6 col-xl-4 offset-xl-1 p-4 rounded-2" style="box-shadow: rgb(38, 57, 77) 0px 20px 30px -10px;">
                <form novalidate autocomplete="off" class="needs-validation" asp-action="SubmitVendorLogin" asp-controller="Account" method="post">

                    <!-- Login Header -->
                    <div class="mb-4 text-center">
                        <p class="lead fw-bold mb-0 me-3 fs-2 text-dark">Vendor Login</p>
                        <p class="py-3 fs-6">
                            For Latest trends, exciting offers and everything Shahosoft®!
                        </p>
                    </div>

                    <!-- Email Input -->
                    <div class="form-outline mb-4">
                        <label asp-for="UserName" class="form-label fw-bold">Email address</label>
                        <input type="email"
                               asp-for="UserName"
                               placeholder="Enter a valid email address"
                               autocomplete="off"
                               class="form-control"
                               required />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <!-- Password Input -->
                    <div class="form-outline mb-3">
                        <label class="form-label fw-bold" asp-for="Password">Password</label>
                        <input type="password"
                               asp-for="Password"
                               placeholder="Enter password"
                               class="form-control"
                               required />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Submit & Navigation Links -->
                    <div class="text-lg-start mt-4 pt-2 d-flex justify-content-center">
                        <div>
                            <div class="mb-2">
                                <button type="submit" class="btn btn-solid p-2 px-5">Login</button>
                            </div>
                            <div>
                                <a href="@Url.Action("Login","Account")" class="link-primary ms-4 text-decoration-underline">
                                    Customer Login
                                </a>
                            </div>
                        </div>
                    </div>

                </form>
            </div>

        </div>
    </div>
</section>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
        (function () {
      'use strict'

      // Fetch all the forms we want to apply custom Bootstrap validation styles to
      var forms = document.querySelectorAll('.needs-validation')

      // Loop over them and prevent submission
      Array.prototype.slice.call(forms)
        .forEach(function (form) {
          form.addEventListener('submit', function (event) {
            if (!form.checkValidity()) {
              event.preventDefault()
              event.stopPropagation()
            }

            form.classList.add('was-validated')
          }, false)
        })
    })()
</script>