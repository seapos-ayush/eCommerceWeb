    <!-- Offconvas cart items -->

    @if(hasItemsInCartList)
    {
        <div class="offcanvas offcanvas-end " tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel"
             style="width: 350px;">
            <div class="offcanvas-header bg-dark text-white">
