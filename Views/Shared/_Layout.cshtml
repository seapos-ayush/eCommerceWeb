    <script>
        document.addEventListener("DOMContentLoaded", function () {

            @* // 🔁 Update quantity on server *@
            function updateQuantity(id, quantity) {
                fetch('/home/cart/updatequantity', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ id: parseInt(id), quantity: parseInt(quantity) })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.status === 'success') {
                        console.log("Quantity updated.");
                    }
                });
            }

            @* // 🧮 Recalculate subtotal *@
            function recalculateSubtotal() {
                let subtotal = 0;
                document.querySelectorAll(".cart-item").forEach(item => {
                    const price = parseFloat(item.dataset.price);
                    const qtyInput = item.querySelector(".qty-input");
                    const quantity = parseInt(qtyInput?.value) || 1;
                    subtotal += price * quantity;
                });

                const subtotalEl = document.getElementById("cart-subtotal");
                if (subtotalEl) {
                    subtotalEl.textContent = `₹${subtotal.toFixed(2)}`;
                }
            }

            @* // ➕➖ Quantity button click *@
            document.querySelectorAll(".qty-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const id = this.dataset.id;
                    const action = this.dataset.action;
                    const input = document.querySelector(`.qty-input[data-id='${id}']`);

                    let currentQty = parseInt(input.value);
                    if (isNaN(currentQty)) currentQty = 1;

                    if (action === "increase") {
                        currentQty += 1;
                    } else if (action === "decrease" && currentQty > 1) {
                        currentQty -= 1;
                    }

                    input.value = currentQty;
                    updateQuantity(id, currentQty);
                    recalculateSubtotal();
                });
            });

            @* // 📝 Manual quantity input change *@
            document.querySelectorAll(".qty-input").forEach(input => {
                input.addEventListener("change", function () {
                    const id = this.dataset.id;
                    let qty = parseInt(this.value);
                    if (!qty || qty < 1) {
                        qty = 1;
                        this.value = 1;
                    }
                    updateQuantity(id, qty);
                    recalculateSubtotal();
                });
            });

            @* // ❌ Remove cart item *@
            document.querySelectorAll(".remove-cart").forEach(button => {
                button.addEventListener("click", function () {

                    const id = this.dataset.id;
                    const itemElement = this.closest("li");

                    fetch('/home/cart/removecartitems', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ id: parseInt(id) })
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.status === 'success') {
                            itemElement.remove();
                            recalculateSubtotal();

                            const cartCount = document.getElementById("cart-count");
                            if (data.count > 0) {
                                if (cartCount) cartCount.textContent = data.count;
                            } else {
                                if (cartCount) cartCount.remove();
                                location.reload();
                            }
                        }
                    });
                });
            });
        });
    </script>


    @await RenderSectionAsync("Scripts", required: false);


