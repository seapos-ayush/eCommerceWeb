<body>

    @{
        var imageBasePath = "https://sahosoftweb.com/Images/Ecomm/";
        var userSession = ViewBag.userDetailsSession as LoginResponse;


        //For Categories
        var userId = userSession?.Id ?? 1;
        if (userSession?.UserType == "") userId = 1;
        var categoryService = Context.RequestServices.GetService(typeof(IProductService)) as IProductService;
        var categories = Enumerable.Empty<CategoryItemsResponse>();

        if (categoryService != null)
        {
            var getAllReq = new GetAllByUserId { UserId = userId };
            var categoryTask = categoryService.GetCategoryAsync(getAllReq);
            categoryTask.Wait();
            var result = categoryTask.Result;
            categories = result?.Data ?? Enumerable.Empty<CategoryItemsResponse>();
        }

        // For Compare List
        var compareList = ViewBag.compareList as List<ProductSessionModel>;
        var hasItemsInCompareList = compareList != null && compareList.Count > 0;
        var countOfCompareItems = hasItemsInCompareList ? compareList?.Count : 0;

        // For Wishlist
        var wishList = ViewBag.wishList as List<ProductSessionModel>;
        var hasItemsInWishList = wishList != null && wishList.Count > 0;
        var countOfWishListItems = hasItemsInWishList ? wishList?.Count : 0;

        // For Cart List
        var cartList = ViewBag.cartList as List<ProductSessionModel>;
        var hasItemsInCartList = cartList != null && cartList.Any();
        var countOfCartItems = hasItemsInCartList ? cartList?.Count : 0;

        var subTotal = cartList != null ? cartList.Sum(c => c.SalePrice * c.Quantity) : 0;
    }

