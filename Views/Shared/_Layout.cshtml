                <button type="button" data-bs-dismiss="offcanvas" aria-label="Close"
                        class="btn-close btn-close-white"></button>
            </div>
            <div class="offcanvas-body">
                <div class="d-flex flex-column flex-shrink-0 bg-light" style="height: 100%;">
                    <div id="parent">
                        <div id="child">
                            <ul class="list-group list-group-flush nav nav-pills flex-column mb-auto">
                            @foreach (var items in cartList)
                            {
                                <li class="cart-item list-group-item py-4 ng-star-inserted" data-price="@items.SalePrice">
                                    <div class="row">
                                        <div class="col-md-4 col-4 align-self-center">
                                            <img alt="..." class="img-fluid"
                                                 src="@($"{@imageBasePath}{@items.Pictures}")">
                                        </div>
                                        <div class="col-md-7 col-7">
                                            <div class="card-body">
                                                <div class="col-md-11">
                                                    <div class="mb-3">
                                                        <a href="@Url.Action("ProductDetails", "Product", new { category = items.Category, id = items.Id })">
                                                            <h6 class="text-black mb-2 text-muted">
                                                                @items.Name
                                                            </h6>
                                                        </a>
                                                        <div>
                                                            <h6 class="mb-0">₹@items.SalePrice</h6>
                                                        </div>
                                                    </div>
                                                    <div class="d-flex">
                                                            <button class="btn px-2 qty-btn" data-id="@items.Id" data-action="decrease">
                                                            <i aria-hidden="true" class="fa fa-minus"></i>
                                                        </button>
                                                            <input type="number" class="form-control text-center qty-input" data-id="@items.Id" style="width:60px" value="@items.Quantity" min="1"  >
                                                            <button class="btn px-2 qty-btn" data-id="@items.Id" data-action="increase" >
                                                            <i aria-hidden="true" class="fa fa-plus"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-1 col-1 text-end align-self-start">
                                               @*  <a disabled="" aria-label="Close" class="btn-close" href="@Url.Action("RemoveFromCart", "Cart", new { productId = items.Id })"></a> *@

                                                <button type="button" class="btn-close remove-cart" data-id="@items.Id" aria-label="Close"></button>
                                        </div>
                                    </div>
                                </li>
                            }
                            <!---->
                            </ul>
                        </div>
                    </div>
                    <hr>
                    <div class="dropdown">
                        <div>
                            <div class="mb-4 offset-lg-1">
                                <h5>Subtotal</h5>
