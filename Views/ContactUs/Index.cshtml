@{
        ViewData["Title"] = "Contact Us - Sahosoft Mall";

}
@model ContactUs_Request
<div class="breadcrumb-section">
    <div class="container">
        <div class="row">
            <div class="col-sm-6">
                <div class="page-title">
                    <h2>contact us</h2>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb" class="theme-breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index","Home") >Home</a>
                        </li>
                        <li class="breadcrumb-item active">contact</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<section class="contact-page section-b-space pt-2">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-10" style="box-shadow: rgba(0, 0, 0, 0.35) 0px 5px 15px;">
                <div class="row">
                    <div class="col-5 bg-warning p-4">
                        <div class="contact-right">
                            <ul>
                                <li>
                                    <div class="contact-icon">
                                        <i class="fa fa-phone text-white" aria-hidden="true"></i>
                                        <h6 class="text-white">Contact Us</h6>
                                    </div>
                                    <div class="media-body">
                                        <p class="text-dark">+91 8376817046</p>
                                        <p class="text-dark">+91 8588805737</p>
                                    </div>
                                </li>
                                <li>
                                    <div class="contact-icon">
                                        <i class="fa fa-map-marker text-white" aria-hidden="true"></i>
                                        <h6 class="text-white">Address</h6>
                                    </div>
                                    <div class="media-body">
                                        <p class="text-dark">ABC Complex,Near xyz, Noida</p>
                                        <p class="text-dark">Noida - 123456</p>
                                    </div>
                                </li>
                                <li>
                                    <div class="contact-icon">
                                        <i class="fa fa-envelope-o text-white" aria-hidden="true"></i>
                                        <h6 class="text-white">Email Address</h6>
                                    </div>
                                    <div class="media-body">
                                        <p class="text-dark">Support@SahosoftMall.com</p>
                                        <p class="text-dark">info@SahosoftMall.com</p>
                                    </div>
                                </li>
                                <li>
                                    <div class="contact-icon">
                                        <i class="fa fa-fax text-white" aria-hidden="true"></i>
                                        <h6 class="text-white">Fax</h6>
                                    </div>
                                    <div class="media-body">
                                        <p class="text-dark">Support@SahosoftMall.com</p>
                                        <p class="text-dark">info@SahosoftMall.com</p>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-7 p-4">
                        <form novalidate autocomplete="off" class="needs-validation" asp-action="Submit" asp-controller="ContactUs" method="post">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold" asp-for="FirstName">First Name</label>
                                    <input 
                                        asp-for="FirstName"
                                        type="text" 
                                        placeholder="Enter Your First name" 
                                        class="form-control mb-1">
                                    <span class="text-danger" asp-validation-for="FirstName"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                                    <input asp-for="LastName" type="text" 
                                           placeholder="Enter Your Last Name" class="form-control mb-1">
                                    <span class="text-danger" asp-validation-for="LastName"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="MobileNo" class="form-label fw-bold">Phone number</label>
                                    <input asp-for="MobileNo" type="text" 
                                           placeholder="Enter your number" class="form-control mb-1">
                                    <span class="text-danger" asp-validation-for="MobileNo"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="EmailId" class="form-label fw-bold">Email</label>
                                    <input asp-for="EmailId" type="text" 
                                           placeholder="Enter your Email" class="form-control mb-1">
                                    <span class="text-danger" asp-validation-for="EmailId"></span>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <label asp-for="Message" class="form-label fw-bold">
                                        Write Your
                                        Message
                                    </label>
                                    <textarea asp-for="Message" placeholder="Write Your Message"
                                               rows="6" class="form-control mb-1"></textarea>
                                    <span class="text-danger" asp-validation-for="Message"></span>
                                </div>
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-solid border-0">
                                        Send Your
                                        Message
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @* <partial name="_ValidationScriptsPartial" /> *@
    @{
      await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

